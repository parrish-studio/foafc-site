{
  "name": "foafc-site",
  "private": true,
  "description": "Friends of A Fierce Chase website and Parrish Studio platform packages",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @foafc/site dev",
    "build": "pnpm --filter @foafc/site build",
    "preview": "pnpm --filter @foafc/site preview",
    "check": "pnpm -r check"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@astrojs/react>oxc-transform-react": "0.152.0"
      }
    }
  }
}
