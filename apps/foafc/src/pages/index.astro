---
import { Image } from 'astro:assets';
import TrailStatus from '../components/TrailStatus.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import heroImage from '../assets/photos/pulk-sled-winter.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * Section order follows the prototype: hero, trail status, welcome, weather,
 * donate prompt. The prototype also has a trailhead map widget; the board
 * brief puts the embedded map on the Trails page, so it is not here yet.
 */
---

<BaseLayout
  title="Home"
  description="Volunteer-built trails in Monson, Maine for skiing, snowshoeing, hiking and fat biking, kept open by Friends of A Fierce Chase."
>
  <div class="hero">
    <Image
      class="hero__image"
      src={heroImage}
      alt=""
      width={968}
      widths={[640, 968]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="eyebrow">Maine trails, shared stewardship</p>
      <h1>Explore. Protect. Connect.</h1>
      <p class="hero__lede">
        A welcoming network of trails and neighbors. Ski, snowshoe, hike, fat bike.
      </p>
      <p class="hero__actions">
        <a class="button" href="/trails/">Explore Trail Maps</a>
        <a class="button button--secondary" href="/donate/">Donate</a>
      </p>
    </div>
  </div>

  <div class="container page stack">
    <TrailStatus />

    <section>
      <p class="eyebrow">Good to know</p>
      <h2>Come find your fierce.</h2>
      <p>
        Whether you arrive on skis, two wheels, snowshoes, or your own two feet, these trails are
        here for quiet miles, bold views, and shared care.
      </p>
    </section>

    <WeatherWidget />

    <section class="callout">
      <p class="eyebrow">Keep the path clear</p>
      <h2>Every mile is a community effort.</h2>
      <p>
        Your support helps keep trail machines moving, bridges steady, and the next season within
        reach.
      </p>
      <p class="callout__actions">
        <a class="button" href="/donate/">Support the trails</a>
      </p>
    </section>
  </div>
</BaseLayout>
