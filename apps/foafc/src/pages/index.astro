---
import { Image } from 'astro:assets';
import TrailStatus from '../components/TrailStatus.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import heroImage from '../assets/photos/pulk-sled-winter.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../content/blog';

/*
 * Section order follows the prototype — see docs/source/prototype-structure.md.
 * Hero, full-bleed status strip, welcome beside weather, three teasers,
 * full-bleed donate band.
 */

/*
 * The middle teaser is the newest post, as the prototype's "Latest Post" card
 * implies. It links to the post itself rather than to the index, which is the
 * whole point of putting it on the home page.
 *
 * Before the first post is published there is nothing to name, so it falls
 * back to describing the blog. Launching with an empty blog is supported, and
 * a card reading "Latest post: none" would be a worse version of saying
 * nothing.
 */
const [latestPost] = await getPublishedPosts();

const teasers = [
  {
    href: '/trails/',
    title: 'Trail Maps',
    copy: 'Find your route, what each trail suits, and how to reach the trailhead.',
  },
  latestPost
    ? {
        href: `/blog/${latestPost.id}/`,
        title: latestPost.data.title,
        copy: latestPost.data.summary ?? 'The newest post from the trails.',
        eyebrow: 'Latest post',
      }
    : {
        href: '/blog/',
        title: 'Latest post',
        copy: 'Notes from the trail crew and whatever the woods are doing this month.',
      },
  {
    href: '/events/',
    title: 'Upcoming events',
    copy: 'Races, volunteer days and community gatherings on the trails.',
  },
];
---

<BaseLayout
  title="Home"
  description="Volunteer-built trails in Monson, Maine for skiing, snowshoeing, hiking and fat biking, kept open by Friends of A Fierce Chase."
>
  <div class="hero">
    <Image
      class="hero__image"
      src={heroImage}
      alt=""
      width={968}
      widths={[640, 968]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="eyebrow">Maine trails, shared stewardship</p>
      <h1>Explore. Protect. Connect.</h1>
      <p class="hero__lede">
        A welcoming network of trails and neighbors. Ski, snowshoe, hike, fat bike.
      </p>
      <p class="hero__actions">
        <a class="button" href="/donate/">Donate</a>
        <a class="button button--secondary" href="/trails/">Explore Trail Maps</a>
      </p>
    </div>
  </div>

  <TrailStatus />

  <div class="container page stack">
    <div class="home-intro">
      <section>
        <p class="eyebrow">Good to know</p>
        <h2>Come find your fierce.</h2>
        <p>
          Whether you arrive on skis, two wheels, snowshoes, or your own two feet, these trails
          are here for quiet miles, bold views, and shared care.
        </p>
      </section>

      <WeatherWidget />
    </div>

    <ul class="teasers">
      {
        teasers.map((teaser) => (
          <li class="teaser">
            {teaser.eyebrow && <p class="eyebrow">{teaser.eyebrow}</p>}
            <h2 class="teaser__title">
              <a href={teaser.href}>{teaser.title}</a>
            </h2>
            <p class="teaser__copy">{teaser.copy}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="donate-band">
    <div class="container donate-band__inner">
      <p class="eyebrow">Keep the path clear</p>
      <h2>Every mile is a community effort.</h2>
      <p>
        Your support helps keep trail machines moving, bridges steady, and the next season within
        reach.
      </p>
      <p><a class="button" href="/donate/">Support the trails</a></p>
    </div>
  </section>
</BaseLayout>
