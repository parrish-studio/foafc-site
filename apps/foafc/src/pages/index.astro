---
import { Image } from 'astro:assets';
import { parseTrailSystem, summarizeTrails } from '@parrish-studio/module-trails';
import trailsData from '@parrish-studio/module-trails/data/trails.json';
import heroImage from '../assets/photos/trailhead-winter.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';

const system = parseTrailSystem(trailsData);
const summary = summarizeTrails(system.trails);

const facts = [
  { label: 'Trails', value: `${system.system.trailCount} named trails` },
  { label: 'Groomed', value: system.system.totalMilesLabel },
  { label: 'Where', value: system.system.location },
  { label: 'Dogs', value: 'Welcome, under verbal control' },
];
---

<BaseLayout
  title="Home"
  description="Friends of A Fierce Chase maintains a volunteer-built cross-country ski trail system in Monson, Maine."
>
  <div class="hero">
    <Image
      class="hero__image"
      src={heroImage}
      alt=""
      width={1286}
      widths={[640, 960, 1286]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="eyebrow">Maine trails, shared stewardship</p>
      <h1>Explore. Protect. Connect.</h1>
      <p class="hero__lede">
        A welcoming network of trails and neighbors caring for the wild places around Monson.
      </p>
      <p class="hero__actions">
        <a class="button" href="/trails/">Explore Trail Maps</a>
      </p>
    </div>
  </div>

  <div class="container page stack">
    <ul class="fact-list">
      {
        facts.map((fact) => (
          <li>
            <span class="fact-list__label">{fact.label}</span>
            <span class="fact-list__value">{fact.value}</span>
          </li>
        ))
      }
    </ul>

    <section>
      <p class="eyebrow">Good to know</p>
      <h2>Come find your fierce.</h2>
      <p>
        Whether you arrive on skis, two wheels, snowshoes, or your own two feet, these trails are
        here for quiet miles, bold views, and shared care.
      </p>
      <p>
        {summary.skateSkiingCount} of the {summary.count} trails are open to skate skiing, and the
        system is groomed by volunteers. Check the <a href="/trails/">trail list, etiquette rules
        and safety notice</a> before your first visit.
      </p>
    </section>
  </div>
</BaseLayout>
