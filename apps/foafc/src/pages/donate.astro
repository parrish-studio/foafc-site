---
import { GIVING_METHODS } from '../data/giving';
import { ORG, SUGGESTED_DONATIONS } from '../data/org';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Donate"
  description={`Support ${ORG.shortName}, a volunteer-run 501(c)(3) maintaining cross-country ski trails in Monson, Maine. Donations are tax-deductible.`}
>
  <div class="container page stack">
    <div class="page-header">
      <p class="eyebrow">Donate / Join</p>
      <h1>Help Us Keep the Trails Open.</h1>
      <p class="page-header__lede">
        Make room for more fresh air, more shared miles, and more moments outside.
      </p>
    </div>

    <section>
      <p>
        This trail system is supported and maintained entirely by volunteers. It is open to the
        public because of your donations. As a 501(c)(3) nonprofit, all contributions are
        tax-deductible.
      </p>
    </section>

    <section>
      <h2>Choose your trail pass</h2>
      <p>
        The trails are free to use. These are suggested amounts, not fees — give what works for
        you, and come ski either way.
      </p>
      <ul class="fact-list">
        {
          SUGGESTED_DONATIONS.map((tier) => (
            <li>
              <span class="fact-list__label">{tier.label}</span>
              <span class="fact-list__value">{tier.amount}</span>
              <span class="fact-list__note">{tier.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="note">Any amount helps, and no amount is expected.</p>
    </section>

    <section>
      <h2>How to give</h2>
      {
        GIVING_METHODS.length === 0 ? (
          <p class="empty-state">
            Online giving is not set up yet. Please check back, or reach out on our Facebook page.
          </p>
        ) : (
          <ul class="giving">
            {GIVING_METHODS.map((method) => (
              <li class="giving__item">
                <h3 class="giving__label">{method.label}</h3>
                <p class="giving__description">{method.description}</p>
                {method.kind === 'mail' ? (
                  <>
                    <p>Made out to {method.payTo}:</p>
                    <address class="address">
                      {method.address.map((line) => (
                        <span>{line}</span>
                      ))}
                    </address>
                  </>
                ) : (
                  <p>
                    <a class="button" href={method.href} rel="noopener">
                      {method.action}
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section>
      <h2>Tax-deductible</h2>
      <p>
        {ORG.legalName} is a {ORG.charityStatus}, effective {ORG.effectiveDate}. Our EIN is {
          ORG.ein
        }. Keep your receipt or cancelled cheque for your records.
      </p>
    </section>
  </div>
</BaseLayout>
