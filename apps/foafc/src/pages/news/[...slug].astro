---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { formatPostDate, getPublishedPosts } from '../../content/news';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Uses the same published-posts rule as the index, so a draft can never be
// reachable by URL after being hidden from the listing.
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={`${post.data.title} — news from Friends of A Fierce Chase.`}>
  <article class="container page stack">
    <div class="page-header">
      <h1>{post.data.title}</h1>
      <p class="page-header__meta">
        <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
        {post.data.draft && <span class="badge-draft">Draft</span>}
      </p>
    </div>

    {
      post.data.coverImage && (
        <Image
          class="post__cover"
          src={post.data.coverImage}
          alt={post.data.coverAlt ?? ''}
          width={1200}
          height={675}
          widths={[640, 960, 1200]}
          sizes="(min-width: 76rem) 72rem, 100vw"
          loading="eager"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    <p><a href="/news/">← All news</a></p>
  </article>
</BaseLayout>
