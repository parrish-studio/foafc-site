---
import { Image } from 'astro:assets';
import { formatPostDate, getPublishedPosts } from '../../content/news';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="News"
  description="News and updates from Friends of A Fierce Chase in Monson, Maine."
>
  <div class="container page stack">
    <div class="page-header">
      <p class="eyebrow">From the trails</p>
      <h1>News, Posts and Events</h1>
      <p class="page-header__lede">Updates from the trails and the board.</p>
    </div>

    {
      posts.length === 0 ? (
        <p class="empty-state">
          No posts yet. News from the trails will appear here — check
          <a href="/events/">Events</a> or our Facebook page in the meantime.
        </p>
      ) : (
        <ul class="card-grid">
          {posts.map((post) => (
            <li class="card">
              <a class="card__link" href={`/news/${post.id}/`}>
                {post.data.coverImage && (
                  <Image
                    class="card__image"
                    src={post.data.coverImage}
                    alt={post.data.coverAlt ?? ''}
                    width={640}
                    height={360}
                    widths={[320, 640, 960]}
                    sizes="(min-width: 48rem) 20rem, 100vw"
                    loading="lazy"
                  />
                )}
                <div class="card__body">
                  <h2 class="card__title">{post.data.title}</h2>
                  {post.data.draft && <span class="badge-draft">Draft</span>}
                  <p class="card__meta">
                    <time datetime={post.data.date.toISOString()}>
                      {formatPostDate(post.data.date)}
                    </time>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
