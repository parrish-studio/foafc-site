---
import {
  TRAIL_DIFFICULTIES,
  difficultyGlyph,
  difficultyLabel,
  formatKm,
  formatMiles,
  parseTrailSystem,
  sortTrailsByLength,
  summarizeTrails,
} from '@parrish-studio/module-trails';
import trailsData from '@parrish-studio/module-trails/data/trails.json';
import { TrailGrid, TrailRules, TrailSafetyNotice } from '@parrish-studio/module-trails/ui';
import '@parrish-studio/module-trails/ui/trails.css';
import TrailheadMap from '../components/TrailheadMap.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Seed data lives in the module for now; it moves to this app once the CMS owns
// trail content (see the module README).
const system = parseTrailSystem(trailsData);
const trails = sortTrailsByLength(system.trails);
const summary = summarizeTrails(trails);
const classicOnly = trails.filter((trail) => !trail.skateSkiing);
---

<BaseLayout
  title="Trails"
  description={`All ${system.system.trailCount} trails at ${system.system.name} in ${system.system.location}, with distance, difficulty and etiquette rules.`}
>
  <div class="container page stack">
    <div class="page-header">
      <p class="eyebrow">Find your way</p>
      <h1>Trail Maps</h1>
      <p class="page-header__lede">
        Plan a visit with route details. {system.system.name} in {system.system.location}: {
          system.system.trailCount
        } named trails covering {system.system.totalMilesLabel}.
      </p>
    </div>

    <ul class="fact-list">
      <li>
        <span class="fact-list__label">Trails listed</span>
        <span class="fact-list__value">{summary.count}</span>
      </li>
      <li>
        <span class="fact-list__label">Total length</span>
        <span class="fact-list__value">{formatMiles(summary.totalMiles)}</span>
      </li>
      <li>
        <span class="fact-list__label">In kilometres</span>
        <span class="fact-list__value">{formatKm(summary.totalKm)}</span>
      </li>
      <li>
        <span class="fact-list__label">Open to skate skiing</span>
        <span class="fact-list__value">{summary.skateSkiingCount} trails</span>
      </li>
    </ul>

    {
      system.system.mapPdf && (
        <p>
          <a class="button" href={system.system.mapPdf} rel="noopener">
            View winter trail map
          </a>
        </p>
      )
    }

    <TrailheadMap />

    <TrailGrid trails={trails} caption="Every trail, longest first" />

    <TrailRules rules={system.rules} />

    <TrailSafetyNotice safety={system.safety} heading="Know before you go" />

    <div class="trail-info">
      <section class="trail-info__card">
        <h2>Trail information</h2>
        <dl class="definitions">
          <dt>Location</dt>
          <dd>{system.system.location}</dd>
          {
            system.system.access && (
              <>
                <dt>Access</dt>
                <dd>{system.system.access}</dd>
              </>
            )
          }
          {
            system.system.funders && system.system.funders.length > 0 && (
              <>
                <dt>Funded by</dt>
                <dd>{system.system.funders.join(' and ')}</dd>
              </>
            )
          }
        </dl>
      </section>

      <section class="trail-info__card">
        <h2>Trail details</h2>
        <dl class="definitions">
          <dt>No skate skiing</dt>
          <dd>{classicOnly.map((trail) => trail.name).join(', ')}</dd>
          <dt>Difficulty key</dt>
          <dd>
            <ul class="difficulty-key">
              {
                TRAIL_DIFFICULTIES.map((difficulty) => (
                  <li>
                    <span class={`ps-trail-difficulty ps-trail-difficulty--${difficulty}`}>
                      <span class="ps-trail-difficulty__glyph" aria-hidden="true">
                        {difficultyGlyph(difficulty)}
                      </span>
                    </span>
                    {difficultyLabel(difficulty)}
                  </li>
                ))
              }
            </ul>
          </dd>
          {
            system.landmarks && system.landmarks.length > 0 && (
              <>
                <dt>Landmarks</dt>
                <dd>{system.landmarks.join(', ')}</dd>
              </>
            )
          }
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>
