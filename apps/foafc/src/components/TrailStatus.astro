---
import { SOCIAL } from '../data/org';

/*
 * The trail status strip. Full-bleed sage, directly under the hero.
 *
 * The prototype shows "All trails open — 6 miles groomed" here. That is live
 * data with no source yet, and where it comes from is still being decided
 * (ADR 0005, docs/plans/trail-status.md). So the strip holds its place and
 * says only what is true. A hard-coded "All trails open" would be the one
 * failure that matters: a stale claim the trails are open, in winter.
 *
 * When the source lands this becomes the real status, and it must carry its
 * own timestamp and expire.
 */
---

<div class="trail-status">
  <p class="container trail-status__inner">
    <span class="trail-status__label">Trail conditions</span>
    <span>
      Posted on <a href={SOCIAL[0].href} rel="noopener">our Facebook page</a> — check there
      before heading out.
    </span>
  </p>
</div>
