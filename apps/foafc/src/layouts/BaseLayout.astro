---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import faviconSrc from '../assets/brand/FOAFC_Color_Icon_Logo.png';
import defaultShareImage from '../assets/photos/pulk-sled-winter.jpg';
import logoSrc from '../assets/brand/FOAFC_Gold_Icon_Logo.png';
// Self-hosted so the site makes no third-party font request.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/libre-franklin';
import { SOCIAL, TRAILHEAD } from '../data/org';
import { isProductionHost } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  /** Used for <meta name="description">; keep it under ~155 characters. */
  description: string;
  /** Force this page out of search results even on the production domain. */
  noindex?: boolean;
  /** Image for link previews. Defaults to the hero photograph. */
  shareImage?: ImageMetadata;
  /** Describes the share image; required whenever one is passed. */
  shareImageAlt?: string;
}

const {
  title,
  description,
  noindex = false,
  shareImage = defaultShareImage,
  shareImageAlt = 'A skier pulling a child in a sled along a snowy trail',
} = Astro.props;

// Order follows the prototype's nav. Donate is rendered separately as a
// button, as it is there.
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/trails/', label: 'Trails' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/events/', label: 'Events' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const year = new Date().getFullYear();

// Keep staging deploys out of search results until the DNS cutover, and let a
// page opt out permanently (draft posts do).
const indexable = isProductionHost(Astro.site) && !noindex;

const pageTitle = `${title} — Friends of A Fierce Chase`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Scrapers need an absolute URL; a site-root-relative path is not enough.
const shareImageUrl = new URL(shareImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Link previews. Without these, anything shared to Facebook — where this
      organisation does most of its talking — falls back to whatever the
      scraper guesses, which is usually the nav and no picture.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Friends of A Fierce Chase" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="icon" type="image/png" href={faviconSrc.src} />
    <link rel="apple-touch-icon" href={faviconSrc.src} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <Image
            class="site-header__mark"
            src={logoSrc}
            alt=""
            width={56}
            densities={[1, 2]}
            loading="eager"
          />
          <span class="site-header__words">
            <span class="site-header__name">Friends of A Fierce Chase</span>
            <span class="site-header__place">{TRAILHEAD.label}</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="button button--small" href="/donate/">Donate</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__block">
          <p class="site-footer__title">Friends of A Fierce Chase</p>
          <p>{TRAILHEAD.label}</p>
          <p>501(c)(3) nonprofit · General information</p>
        </div>

        <div class="site-footer__block">
          <p class="site-footer__heading">Follow along</p>
          <ul class="site-footer__links">
            {
              SOCIAL.map((link) => (
                <li>
                  <a href={link.href} rel="me noopener">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="site-footer__block">
          <p class="site-footer__heading">Support the trails</p>
          <ul class="site-footer__links">
            <li><a href="/donate/">Donate</a></li>
            <li><a href="/trails/">Trail maps</a></li>
            <li><a href="/about/">About us</a></li>
          </ul>
        </div>
      </div>

      <div class="container site-footer__legal">
        <p>© {year} Friends of A Fierce Chase</p>
      </div>
    </footer>
  </body>
</html>
