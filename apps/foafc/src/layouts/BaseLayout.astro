---
import { Image } from 'astro:assets';
import faviconSrc from '../assets/brand/FOAFC_Color_Icon_Logo.png';
import logoSrc from '../assets/brand/FOAFC_Color_Primary_Logo.png';
// Self-hosted so the site makes no third-party font request.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/libre-franklin';
import { SOCIAL, TRAILHEAD } from '../data/org';
import { isProductionHost } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  /** Used for <meta name="description">; keep it under ~155 characters. */
  description: string;
  /** Force this page out of search results even on the production domain. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Order follows the prototype's nav. Donate is rendered separately as a
// button, as it is there.
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/trails/', label: 'Trails' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/events/', label: 'Events' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const year = new Date().getFullYear();

// Keep staging deploys out of search results until the DNS cutover, and let a
// page opt out permanently (draft posts do).
const indexable = isProductionHost(Astro.site) && !noindex;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Friends of A Fierce Chase</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={faviconSrc.src} />
    <link rel="apple-touch-icon" href={faviconSrc.src} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <Image
            class="site-header__mark"
            src={logoSrc}
            alt=""
            width={56}
            densities={[1, 2]}
            loading="eager"
          />
          <span class="site-header__words">
            <span class="site-header__name">Friends of A Fierce Chase</span>
            <span class="site-header__place">{TRAILHEAD.label}</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="button button--small" href="/donate/">Donate</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__title">Friends of A Fierce Chase</p>
        <p>Monson, Maine</p>
        <p>501(c)(3) nonprofit · General information</p>
        <p class="site-footer__social">
          <span>Follow along:</span>
          {
            SOCIAL.map((link) => (
              <a href={link.href} rel="me noopener">
                {link.label}
              </a>
            ))
          }
        </p>
        <p>© {year} Friends of A Fierce Chase</p>
      </div>
    </footer>
  </body>
</html>
