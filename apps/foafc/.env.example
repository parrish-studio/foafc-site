# Copy to .env for local development. Never commit the real .env —
# this repository is public.
#
# These four are generated by visiting /keystatic/setup on a running dev
# server, which creates the Keystatic GitHub App and writes them here.
# The same values go into the hosting dashboard. See HANDOFF.md.

# Secret. Authenticates the GitHub App.
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Secret. Encrypts editor session cookies. Must be at least 32 characters.
KEYSTATIC_SECRET=

# Not secret. Appears in OAuth redirect URLs.
KEYSTATIC_GITHUB_CLIENT_ID=
# Not secret by design — the PUBLIC_ prefix inlines it into the browser bundle.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# The origin this build is served from. Set it on any non-production domain so
# canonical URLs are correct and the site is not indexed. Remove at the DNS
# cutover. See src/site.ts.
# SITE_URL=https://example.vercel.app
